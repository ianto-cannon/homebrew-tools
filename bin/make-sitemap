#!/usr/bin/env bash
# makeSiteMap [-e EXT] BASE-URL [DIRECTORY] — write a sitemap.xml for a
# static site. Scans DIRECTORY (default: the current one) recursively for
# the given file types, skipping hidden files. index.html maps to its
# directory's URL; <lastmod> is each file's last git commit date (mtime
# outside a git repository); spaces become %20 and XML specials are
# escaped. changefreq/priority are omitted: search engines ignore them.
#
#   -e EXT    Extensions to include, comma or space separated
#             (default: "html htm pdf").
#   BASE-URL  Domain or full URL; bare domains get https:// and trailing
#             slashes are stripped.
#
# Examples:
#   makeSiteMap ianto-cannon.github.io
#   makeSiteMap -e html,htm ianto-cannon.github.io
#   makeSiteMap -e pdf https://ianto-cannon.github.io/docs docs

set -euo pipefail

usage() { grep '^# ' "$0" | sed 's/^# \{0,1\}//'; exit 1; }

TYPES="html htm pdf"
while getopts ":e:h" opt; do
    case $opt in
        e) TYPES=${OPTARG//,/ } ;;
        h) usage ;;
        :) printf 'makeSiteMap: -%s needs an argument\n' "$OPTARG" >&2; exit 1 ;;
        *) usage ;;
    esac
done
shift $((OPTIND - 1))
[ $# -ge 1 ] && [ $# -le 2 ] || usage
BASE=$1
DIR=${2:-.}

[ -d "$DIR" ] || { printf 'makeSiteMap: not a directory: %s\n' "$DIR" >&2; exit 1; }
case $BASE in *://*) ;; *) BASE="https://$BASE" ;; esac
BASE=${BASE%/}

# <lastmod>: last git commit date for the file (correct even in fresh
# clones and CI checkouts), else its mtime (GNU stat/date first, then BSD).
lastmod_date() {
    local f=$1 d epoch
    if d=$(git log -1 --format=%cs -- "$f" 2>/dev/null) && [ -n "$d" ]; then
        printf '%s\n' "$d"
        return 0
    fi
    if ! epoch=$(stat -c %Y "$f" 2>/dev/null); then
        epoch=$(stat -f %m "$f" 2>/dev/null) || return 0
    fi
    date -u -d "@$epoch" +%F 2>/dev/null || date -u -r "$epoch" +%F 2>/dev/null || true
}

xml_escape() {
    printf '%s' "$1" \
        | sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g' \
              -e "s/'/\&apos;/g" -e 's/"/\&quot;/g'
}

# ./sub/page.html -> sub/page.html (spaces -> %20, index.html -> its directory).
url_path() {
    local p=${1#./}
    p=${p// /%20}
    case $p in
        index.html|index.htm) p="" ;;
        */index.html)         p=${p%/index.html}/ ;;
        */index.htm)          p=${p%/index.htm}/ ;;
    esac
    printf '%s' "$p"
}

name_tests=()
for t in $TYPES; do name_tests+=( -o -name "*.$t" ); done
[ ${#name_tests[@]} -gt 0 ] || { printf 'makeSiteMap: empty -e list\n' >&2; exit 1; }

cd "$DIR"
OUT=$PWD/sitemap.xml
TMP=$(mktemp "$OUT.XXXXXX")
trap 'rm -f "$TMP"' EXIT

{
    printf '<?xml version="1.0" encoding="UTF-8"?>\n'
    printf '<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">\n'

    # Prune on './.*': '-name .*' matches '.' itself and prunes the whole tree.
    find . -path './.*' -prune -o -type f \( "${name_tests[@]:1}" \) -print \
        | LC_ALL=C sort \
        | while IFS= read -r f; do
            p=$(url_path "$f")
            if [ -n "$p" ]; then url="$BASE/$p"; else url="$BASE/"; fi
            printf '  <url>\n    <loc>%s</loc>\n' "$(xml_escape "$url")"
            lm=$(lastmod_date "$f")
            if [ -n "$lm" ]; then
                printf '    <lastmod>%s</lastmod>\n' "$lm"
            fi
            printf '  </url>\n'
        done

    printf '</urlset>\n'
} > "$TMP"

mv "$TMP" "$OUT"
trap - EXIT
printf 'makeSiteMap: wrote %s (%s pages)\n' "$OUT" "$(grep -c '<loc>' "$OUT")"
